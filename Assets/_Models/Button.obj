f 31/1/22 32/2/22 40/3/22 39/4/22
f 32/1/22 25/2/22 33/3/22 40/4/22

# Beveled side wall (from v25-v32 to v33-v40)
f 33/1/23 41/2/13 42/3/14 34/4/24 # This should be quad between levels
f 34/1/24 42/2/14 43/3/15 35/4/25
f 35/1/25 43/2/15 44/3/16 36/4/26
