# Button OBJ File based on the provided image
# Featuring a smooth dome top and a beveled base
# Divided into 'button_base' and 'button_top' groups for separate material application

# Vertices (v)

# --- Button Top Vertices (Dome) ---
# Center of the dome top
v 0.0 0.5 0.0 # v1 (Center Top)

# Top surface edge (approx. radius 0.8) - these vertices form the base of the dome
v 0.8 0.4 0.0
v 0.707 0.4 0.4
v 0.0 0.4 0.8
v -0.707 0.4 0.4
v -0.8 0.4 0.0
v -0.707 0.4 -0.4
v 0.0 0.4 -0.8
v 0.707 0.4 -0.4

# Middle of the dome (approx. radius 0.95)
v 0.95 0.3 0.0
v 0.672 0.3 0.672
v 0.0 0.3 0.95
v -0.672 0.3 0.672
v -0.95 0.3 0.0
v -0.672 0.3 -0.672
v 0.0 0.3 -0.95
v 0.672 0.3 -0.672

# Bottom edge of the dome (approx. radius 1.0, connecting to base)
v 1.0 0.0 0.0
v 0.707 0.0 0.707
v 0.0 0.0 1.0
v -0.707 0.0 0.707
v -1.0 0.0 0.0
v -0.707 0.0 -0.707
v 0.0 0.0 -1.0
v 0.707 0.0 -0.707

# --- Button Base Vertices ---
# Top edge of base (matching dome bottom edge)
# These are technically duplicates of v17-v24, but keeping them separate for clarity of base group
v 1.0 0.0 0.0   # v25
v 0.707 0.0 0.707 # v26
v 0.0 0.0 1.0   # v27
v -0.707 0.0 0.707 # v28
v -1.0 0.0 0.0   # v29
v -0.707 0.0 -0.707 # v30
v 0.0 0.0 -1.0   # v31
v 0.707 0.0 -0.707 # v32

# Beveled edge of base (slightly wider)
v 1.1 -0.1 0.0
v 0.778 -0.1 0.778
v 0.0 -0.1 1.1
v -0.778 -0.1 0.778
v -1.1 -0.1 0.0
v -0.778 -0.1 -0.778
v 0.0 -0.1 -1.1
v 0.778 -0.1 -0.778

# Bottom edge of base (widest, flat)
v 1.2 -0.2 0.0
v 0.8485 -0.2 0.8485
v 0.0 -0.2 1.2
v -0.8485 -0.2 0.8485
v -1.2 -0.2 0.0
v -0.8485 -0.2 -0.8485
v 0.0 -0.2 -1.2
v 0.8485 -0.2 -0.8485

# Center of the base bottom
v 0.0 -0.2 0.0 # v49 (Center Bottom)

# Normals (vn)
# For dome top
vn 0.0 1.0 0.0   # vn1 (Top Center)
vn 0.707 0.707 0.0 # vn2
vn 0.0 0.707 0.707 # vn3
vn -0.707 0.707 0.0 # vn4
vn 0.0 0.707 -0.707 # vn5
vn 0.707 0.0 0.0   # vn6 (Side-ish)
vn 0.0 0.0 1.0   # vn7
vn -0.707 0.0 0.707 # vn8
vn -1.0 0.0 0.0   # vn9
vn -0.707 0.0 -0.707 # vn10
vn 0.0 0.0 -1.0   # vn11
vn 0.707 0.0 -0.707 # vn12

# For base side walls (outwards)
vn 1.0 0.0 0.0   # vn13
vn 0.707 0.0 0.707 # vn14
vn 0.0 0.0 1.0   # vn15
vn -0.707 0.0 0.707 # vn16
vn -1.0 0.0 0.0   # vn17
vn -0.707 0.0 -0.707 # vn18
vn 0.0 0.0 -1.0   # vn19
vn 0.707 0.0 -0.707 # vn20

# For flat bottom surface
vn 0.0 -1.0 0.0  # vn21

# For top horizontal surface (connection to dome base)
vn 0.0 1.0 0.0 # vn22 (Points up, but for flat surface)

# For beveled side (outwards, slightly downwards)
vn 0.707 -0.707 0.0 # vn23
vn 0.0 -0.707 0.707 # vn24
vn -0.707 -0.707 0.0 # vn25
vn 0.0 -0.707 -0.707 # vn26


# Texture Coordinates (vt) - Simple placeholder UVs
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vt 0.5 0.5 # For center points


# --- Button Top Group ---
g button_top

# Dome Top Face (from center to first ring)
f 1/5/1 2/1/2 9/2/2
f 1/5/1 9/1/2 10/2/3
f 1/5/1 10/1/3 3/2/3
f 1/5/1 3/1/3 11/2/4
