f 8/1/8 23/2/12 24/3/6 9/4/2
f 9/1/2 24/2/6 17/3/6 2/4/2 # Closing the dome side (quads)


# --- Button Base Group ---
g button_base

# Top surface of the base (flat ring, connects to bottom of dome)
# This uses the duplicate vertices v25-v32 for button_base's top edge
f 25/1/22 26/2/22 34/3/22 33/4/22 # Bevel top for clarity
f 26/1/22 27/2/22 35/3/22 34/4/22
f 27/1/22 28/2/22 36/3/22 35/4/22
f 28/1/22 29/2/22 37/3/22 36/4/22
